{
  "name": "open-hebrew-bible",
  "version": "0.1.0",
  "license": "MIT",
  "description": "A Hebrew-first reader for the Tanakh with morphology, BDB lexicon, and linked study resources.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "import:oshb": "tsx scripts/import-oshb.ts",
    "import:citations": "tsx scripts/import-citation-map.ts",
    "import:geocoding": "tsx scripts/import-geocoding.ts",
    "import:translations": "tsx scripts/import-translations.ts",
    "build:derived": "tsx scripts/build-derived-corpus.ts",
    "catalog:external": "tsx scripts/build-external-catalogs.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "json5": "^2.2.3",
    "next": "16.1.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^15.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
