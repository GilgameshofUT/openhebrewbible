.git
.gitignore
node_modules
.next
out
local
Screenshots
.openchamber
tests
*.tsbuildinfo
npm-debug.log*
.DS_Store
__pycache__
*.pyc

# Regenerated inside the image by the data stage. manifest.json is the one
# tracked file the data stage needs to seed the provenance record.
data/generated/*
!data/generated/manifest.json
# Committed translation texts (converted to Jewish versification) are read
# at runtime, so they must reach the runner stage.
data/sources
!data/sources/kjv
!data/sources/web
!data/sources/ylt
!data/sources/bsb
