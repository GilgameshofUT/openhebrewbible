node_modules/
.next/
out/
*.tsbuildinfo
.DS_Store
__pycache__/
*.pyc

# Environment files — never commit secrets.
# .env.example stays trackable so docs can show the shape without values.
.env
.env.*
!.env.example

# Raw upstream sources, re-fetched by npm run import:oshb.
# Exception: data/sources/kjv is tracked and read at runtime (see NOTICE).
data/imports/
data/sources/

# Local screenshots and scratch captures
Screenshots/
.openchamber/

# Generated corpus data. All of it is reproducible from pinned upstream
# sources, so none of it is committed:
#   npm run import:oshb       -> oshb-corpus.json, oshb-lexicon.json, manifest.json
#   npm run import:citations  -> jewish-to-christian-citation-map.json
#   npm run build:derived     -> books/, occurrence-index.json
# manifest.json is tracked as the provenance record (release + SHA-256).
data/generated/*.json
!data/generated/manifest.json
# derived-manifest.json is regenerated by build:derived, so it is not tracked.
data/generated/books/

# Everything not required to run the app: planning docs, research reports,
# one-off provenance scripts, upstream archives. Kept locally, not published.
local/
