{"book":"Zephaniah","chapters":[{"chapter":"1","verses":[{"verse":"1","text":""},{"verse":"2","text":""},{"verse":"3","text":""},{"verse":"4","text":""},{"verse":"5","text":""},{"verse":"6","text":""},{"verse":"7","text":"The day of Hashem is coming. A day of slaughter."},{"verse":"8","text":""},{"verse":"9","text":""},{"verse":"10","text":""},{"verse":"11","text":""},{"verse":"12","text":"I will search out Jerusalem with candles. I will take revenge on people who think that Hashem doesn't care."},{"verse":"13","text":""},{"verse":"14","text":""},{"verse":"15","text":""},{"verse":"16","text":""},{"verse":"17","text":""},{"verse":"18","text":"Your money won't help you on the day of Hashem's anger"}]},{"chapter":"2","verses":[{"verse":"1","text":""},{"verse":"2","text":""},{"verse":"3","text":""},{"verse":"4","text":""},{"verse":"5","text":""},{"verse":"6","text":""},{"verse":"7","text":""},{"verse":"8","text":""},{"verse":"9","text":""},{"verse":"10","text":""},{"verse":"11","text":""},{"verse":"12","text":""},{"verse":"13","text":""},{"verse":"14","text":""},{"verse":"15","text":""}]},{"chapter":"3","verses":[{"verse":"1","text":""},{"verse":"2","text":""},{"verse":"3","text":""},{"verse":"4","text":""},{"verse":"5","text":""},{"verse":"6","text":""},{"verse":"7","text":""},{"verse":"8","text":""},{"verse":"9","text":""},{"verse":"10","text":""},{"verse":"11","text":""},{"verse":"12","text":""},{"verse":"13","text":""},{"verse":"14","text":""},{"verse":"15","text":""},{"verse":"16","text":""},{"verse":"17","text":""},{"verse":"18","text":""},{"verse":"19","text":""},{"verse":"20","text":""}]}]}
