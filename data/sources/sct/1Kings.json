5","text":""},{"verse":"26","text":"...And to Abiathar the priest the king said, \"Go to Anathoth to your own fields, for you (are) deservant of death, but on this day I will not put you to death, because you did bear the ark of the Lord God before David, my father, and because you were afflicted in all wherein my father was afflicted."},{"verse":"27","text":""},{"verse":"28","text":""},{"verse":"29","text":""},{"verse":"30","text":""},{"verse":"31","text":""},{"verse":"32","text":""},{"verse":"33","text":""},{"verse":"34","text":""},{"verse":"35","text":""},{"verse":"36","text":""},{"verse":"37","text":""},{"verse":"38","text":""},{"verse":"39","text":""},{"verse":"40","text":""},{"verse":"41","text":""},{"verse":"42","text":""},{"verse":"43","text":""},{"verse":"44","text":""},{"verse":"45","text":""},{"verse":"46","text":""}]},{"chapter":"3","verses":[{"verse":"1","text":""},{"verse":"2","text":""},{"verse":"3","text":""},{"verse":"4","text":""},{"verse":"5","text":""},{"verse":"6","text":""},{"verse":"7","text":""},{"verse":"8","text":""},{"verse":"9","text":""},{"verse":"10","text":""},{"verse":"11","text":""},{"verse":"12","text":""},{"verse":"13","text":""},{"verse":"14","text":""},{"verse":"15","text":""},{"verse":"16","text":""},{"verse":"17","text":""},{"verse":"18","text":""},{"verse":"19","text":""},{"verse":"20","text":""},{"verse":"21","text":""},{"verse":"22","text":""},{"verse":"23","text":""},{"verse":"24","text":""},{"verse":"25","text":""},{"verse":"26","text":""},{"verse":"27","text":""},{"verse":"28","text":""}]},{"chapter":"4","verses":[{"verse":"1","text":""},{"verse":"2","text":""},{"verse":"3","text":""},{"verse":"4","text":""},{"verse":"5","text":""},{"verse":"6","text":""},{"verse":"7","text":""},{"verse":"8","text":""},{"verse":"9","text":""},{"verse":"10","text":""},{"verse":"11","text":""},{"verse":"12","text":""},{"verse":"13","text":""},{"verse":"14","text":""},{"verse":"15","text":""},{"verse":"16","text":""},{"verse":"17","text":""}